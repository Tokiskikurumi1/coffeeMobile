<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Quay lại"
        android:textSize="16sp"
        android:textColor="#E53935"
        android:layout_marginBottom="15dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thống Kê Doanh Thu"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>
    <!-- START DATE -->
    <TextView
        android:text="Ngày Bắt Đầu"
        android:textColor="#E53935"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/edtStart"
        android:hint="Nhập ngày bắt đầu"
        android:focusable="false"
        android:clickable="true"
        android:background="@android:drawable/editbox_background"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- END DATE -->
    <TextView
        android:text="Ngày Kết Thúc"
        android:textColor="#E53935"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/edtEnd"
        android:hint="Nhập ngày kết thúc"
        android:focusable="false"
        android:clickable="true"
        android:background="@android:drawable/editbox_background"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- BUTTON -->
    <Button
        android:id="@+id/btnFilter"
        android:text="Thống Kê"
        android:backgroundTint="#E53935"
        android:textColor="#FFF"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:layout_width="200dp"
        android:layout_height="50dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRevenue"
        android:layout_width="match_parent"
        android:layout_height="402dp"
        android:layout_marginTop="10dp" />
    <TextView
        android:id="@+id/txtTotalRevenue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tổng doanh thu: 0 VND"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#E53935"
        android:gravity="end"
        android:paddingTop="10dp"/>
</LinearLayout>
